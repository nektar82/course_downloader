#
# Maintain the correct line endings for each platform.
#

# Source code.
*.py text eol=lf

# Config files.
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts.
*.sh text eol=lf
